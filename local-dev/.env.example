# Clone all product repos as siblings of ssp-doc, or set absolute paths here.
SSP_CP_REPO=../ssp-cp
SSP_WORKERS_REPO=../ssp-workers
SSP_UI_REPO=../ssp-ui

# Optional overrides (defaults match docker-compose.yml)
# Local Postgres only — published to the host:
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=postgres
# Do not set SSP_DATABASE_URL here for Compose; services use the local postgres service.
# SPP_API_URL=http://localhost:8080

# Sidekick / portal chat (LLM calls from ssp-cp only — never commit the key)
SSP_ASSISTANT_ENABLED=true
SSP_ASSISTANT_API_KEY=
# anthropic (default) or openai
SSP_ASSISTANT_PROVIDER=anthropic
SSP_ASSISTANT_MODEL=claude-3-5-haiku-20241022
# Optional proxy / alternate endpoint
# SSP_ASSISTANT_BASE_URL=
